# Copy to .env (or set in your host's dashboard). Nothing here is required for local dev.

PORT=3000
NODE_ENV=development

# REQUIRED in production. Long random string: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty when the frontend is served by this same server (default).
FRONTEND_URL=

# Real PostgreSQL (Render / Supabase / Neon). Leave empty to use embedded Postgres (PGlite) stored in ./data/pgdata.
DATABASE_URL=
DATABASE_SSL=false

# Insert demo users/riders/orders into an empty database (set false for a clean DB)
SEED_DEMO_DATA=true
