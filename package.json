{
  "name": "logipulse",
  "version": "1.0.0",
  "description": "LogiPulse - courier & last-mile delivery platform (SENTEC / The Web Forces)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
