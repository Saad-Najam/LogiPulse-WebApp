{
  "name": "logipulse",
  "version": "1.0.0",
  "description": "LogiPulse - courier & last-mile delivery platform (SENTEC / The Web Forces)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "vite build",
    "build:client": "vite build",
    "test": "node --test --test-concurrency=1",
    "db:check": "node scripts/db.js check",
    "db:setup": "node scripts/db.js setup",
    "db:reset": "node scripts/db.js reset",
    "e2e": "node e2e/full-flow.mjs",
    "e2e:seed": "node e2e/seed-demo.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.12",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
