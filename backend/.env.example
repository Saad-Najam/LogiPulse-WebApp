# === LogiPulse Backend Environment Variables ===

# Node environment
NODE_ENV=production

# JWT signing secret (generate a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# PostgreSQL connection string (Supabase Session Pooler recommended)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:password@host:5432/dbname?sslmode=require

# Set to true when using SSL (Supabase / Railway)
DATABASE_SSL=true

# Max pool connections
DATABASE_POOL_MAX=5

# Comma-separated list of allowed frontend origins
# Example: https://logipulse.vercel.app,https://logipulse-git-main.vercel.app
FRONTEND_URL=http://localhost:5173

# Seed demo users/orders on first boot (true/false)
SEED_DEMO_DATA=false

# PORT is automatically provided by Railway - do NOT set this manually in Railway
# PORT=3000
