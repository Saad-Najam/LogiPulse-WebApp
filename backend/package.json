{
  "name": "logipulse-backend",
  "version": "1.0.0",
  "description": "LogiPulse API server (Express + Socket.IO + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1",
    "db:check": "node scripts/db.js check",
    "db:setup": "node scripts/db.js setup",
    "db:reset": "node scripts/db.js reset",
    "e2e": "node e2e/full-flow.mjs",
    "e2e:seed": "node e2e/seed-demo.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.12",
    "@types/node": "^22.13.4",
    "puppeteer-core": "^25.13.0"
  }
}
